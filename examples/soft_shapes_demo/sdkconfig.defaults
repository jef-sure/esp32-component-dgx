CONFIG_IDF_TARGET="esp32s3"
CONFIG_DGX_ENABLE_SPI=y
CONFIG_DGX_ENABLE_CO5300=y
CONFIG_DGX_ENABLE_VSCREEN=y

# Waveshare ESP32-S3-Touch-AMOLED-1.32: 8 MB of flash and 8 MB of octal PSRAM,
# where the CO5300 driver keeps its copy of the screen
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# full speed, a frame is drawn anew every time
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
