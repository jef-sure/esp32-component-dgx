CONFIG_IDF_TARGET="esp32p4"
CONFIG_DGX_ENABLE_DSI=y
CONFIG_DGX_ENABLE_JD9165=y
CONFIG_DGX_ENABLE_VSCREEN=y

# The frame buffer the display is sent from lives in PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Drawing goes through the cache of the PSRAM: a larger one makes it faster
# and takes internal RAM, see the README
CONFIG_CACHE_L2_CACHE_256KB=y

# The board this was made on has a chip of revision 1.3.
# Remove the line for a chip of revision 3.0 or later.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
