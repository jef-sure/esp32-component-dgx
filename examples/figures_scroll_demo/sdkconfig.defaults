# The demo is made for two boards: the settings of each are in
# sdkconfig.defaults.esp32 (a CYD) and sdkconfig.defaults.esp32p4 (a JC1060P470).
CONFIG_DGX_ENABLE_VSCREEN=y

# full speed: the times in the log are those of -O2
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
