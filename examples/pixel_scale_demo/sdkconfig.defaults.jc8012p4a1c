# The Guition JC8012P4A1C, 10.1-inch: read after the other two with
#   idf.py -B build_jc8012p4a1c -D SDKCONFIG=build_jc8012p4a1c/sdkconfig -D IDF_TARGET=esp32p4 \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32p4;sdkconfig.defaults.jc8012p4a1c" build
CONFIG_EXAMPLE_BOARD_JC8012P4A1C=y
CONFIG_DGX_ENABLE_JD9365=y

# Its chip is of revision 3.2: a build for revision 1 does not start on it
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_SPIRAM_SPEED_250M=y
