menu "DGX"

config DGX_ENABLE_SPI
    bool "Enable SPI transport backend"
    default n

config DGX_ENABLE_I2C
    bool "Enable I2C transport backend"
    default n

config DGX_ENABLE_P8
    bool "Enable 8-bit parallel transport backend"
    depends on SOC_LCD_I80_SUPPORTED
    default n

config DGX_ENABLE_DSI
    bool "Enable MIPI-DSI transport backend"
    depends on SOC_MIPI_DSI_SUPPORTED
    default n

config DGX_DSI_HARDWARE_COPY
    bool "Move and fill pixels of a DSI display by the hardware of the chip"
    depends on DGX_ENABLE_DSI && SOC_DMA2D_SUPPORTED
    default y
    help
        Large pieces go past the processor, several times as fast: a part
        of a 16-bit virtual screen put to the display and, with two frame
        buffers, what one of them lacks of the other by the 2D DMA; a
        rectangle filled with a color by the pixel processing accelerator
        (PPA). It costs 0.8 KB of RAM.

        The accelerator has a public interface. The 2D DMA is driven
        through a private interface of IDF, esp_private/dma2d.h, and one
        field of a register of the chip is set directly, for IDF 6.0.3 and
        later do not set it for 16-bit pixels. Should an IDF not build with
        it, or the 2D DMA and the accelerator be wanted for something else,
        turn this off: the processor does all of it then.

config DGX_ENABLE_SPI_ST7735
    bool "Enable ST7735 panel driver"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_P8
    default n

config DGX_ENABLE_SPI_ST7789
    bool "Enable ST7789 panel driver"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_P8
    default n

config DGX_ENABLE_SPI_GC9A01
    bool "Enable GC9A01 panel driver"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_P8
    default n

config DGX_ENABLE_SPI_ILI_9341
    bool "Enable ILI9341 panel driver"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_P8
    default n

config DGX_ENABLE_SSD1351
    bool "Enable SSD1351 panel driver"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_P8
    default n

config DGX_ENABLE_JD9165
    bool "Enable JD9165 panel driver"
    depends on DGX_ENABLE_DSI
    default n

config DGX_ENABLE_SSD1306
    bool "Enable SSD1306 controller"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_I2C
    select DGX_ENABLE_V_BW_SCREEN
    default n

config DGX_ENABLE_ST7565R
    bool "Enable ST7565R controller"
    depends on DGX_ENABLE_SPI
    select DGX_ENABLE_V_BW_SCREEN
    default n

config DGX_ENABLE_ST7920
    bool "Enable ST7920 controller"
    depends on DGX_ENABLE_SPI || DGX_ENABLE_I2C || DGX_ENABLE_P8
    select DGX_ENABLE_VSCREEN
    default n

config DGX_ENABLE_V_BW_SCREEN
    bool "Enable monochrome virtual/back screen"
    default n

config DGX_ENABLE_VSCREEN
    bool "Enable RAM-backed virtual screen"
    default n

config DGX_ENABLE_VSCREEN_2H
    bool "Enable dual-head virtual compositor"
    depends on DGX_ENABLE_VSCREEN
    default n

config DGX_ENABLE_MORPH
    bool "Enable dot morphing framework (bit-matrix morphs, glow/sprite renderers)"
    select DGX_ENABLE_VSCREEN
    default n

endmenu